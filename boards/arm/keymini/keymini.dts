/dts-v1/;
#include <st/f0/stm32f072Xb.dtsi>
#include <st/f0/stm32f072c(8-b)tx-pinctrl.dtsi>

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
	model = "Keymini";
	compatible = "texitoi,keymini", "st,stm32f072";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,kscan = &kscan0;
		zmk,physical-layout = &keymini_layout;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";

		diode-direction = "row2col";

		debounce-press-ms = <5>;
		debounce-release-ms = <5>;

		col-gpios
			= <&gpioa 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpioa 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpioa 5  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpioa 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpioa 7  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpiob 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpiob 1  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpiob 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpiob 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpiob 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			;
		row-gpios
			= <&gpiob 3 GPIO_ACTIVE_LOW>
			, <&gpiob 4 GPIO_ACTIVE_LOW>
			, <&gpiob 5 GPIO_ACTIVE_LOW>
			, <&gpiob 6 GPIO_ACTIVE_LOW>
			;
	};

	default_transform: keymap_transform {
		compatible = "zmk,matrix-transform";
		rows = <4>;
		columns = <10>;

		map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
			                RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7)
		>;
	};

	keymini_layout: physical_layout {
		compatible = "zmk,physical-layout";
		display-name = "Default";
		kscan = <&kscan0>;
		transform = <&default_transform>;

		keys  //                     w   h    x    y rot   rx   ry
			= <&key_physical_attrs 100 100    0    0 0 0 0>
			, <&key_physical_attrs 100 100  100    0 0 0 0>
			, <&key_physical_attrs 100 100  200    0 0 0 0>
			, <&key_physical_attrs 100 100  300    0 0 0 0>
			, <&key_physical_attrs 100 100  400    0 0 0 0>
			, <&key_physical_attrs 100 100  550    0 0 0 0>
			, <&key_physical_attrs 100 100  650    0 0 0 0>
			, <&key_physical_attrs 100 100  750    0 0 0 0>
			, <&key_physical_attrs 100 100  850    0 0 0 0>
			, <&key_physical_attrs 100 100  950    0 0 0 0>
			, <&key_physical_attrs 100 100    0  100 0 0 0>
			, <&key_physical_attrs 100 100  100  100 0 0 0>
			, <&key_physical_attrs 100 100  200  100 0 0 0>
			, <&key_physical_attrs 100 100  300  100 0 0 0>
			, <&key_physical_attrs 100 100  400  100 0 0 0>
			, <&key_physical_attrs 100 100  550  100 0 0 0>
			, <&key_physical_attrs 100 100  650  100 0 0 0>
			, <&key_physical_attrs 100 100  750  100 0 0 0>
			, <&key_physical_attrs 100 100  850  100 0 0 0>
			, <&key_physical_attrs 100 100  950  100 0 0 0>
			, <&key_physical_attrs 100 100    0  200 0 0 0>
			, <&key_physical_attrs 100 100  100  200 0 0 0>
			, <&key_physical_attrs 100 100  200  200 0 0 0>
			, <&key_physical_attrs 100 100  300  200 0 0 0>
			, <&key_physical_attrs 100 100  400  200 0 0 0>
			, <&key_physical_attrs 100 100  550  200 0 0 0>
			, <&key_physical_attrs 100 100  650  200 0 0 0>
			, <&key_physical_attrs 100 100  750  200 0 0 0>
			, <&key_physical_attrs 100 100  850  200 0 0 0>
			, <&key_physical_attrs 100 100  950  200 0 0 0>
			, <&key_physical_attrs 100 100  200  300 0 0 0>
			, <&key_physical_attrs 100 100  300  300 0 0 0>
			, <&key_physical_attrs 100 100  400  300 0 0 0>
			, <&key_physical_attrs 100 100  550  300 0 0 0>
			, <&key_physical_attrs 100 100  650  300 0 0 0>
			, <&key_physical_attrs 100 100  750  300 0 0 0>
			;
	};
};

zephyr_udc0: &usb {
	status = "okay";

	pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
	pinctrl-names = "default";

	/* Reduce from the default to save RAM */
	num-bidir-endpoints = <4>;
};

&clk_hsi {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&pll {
	prediv = <1>;
	mul = <6>;
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(48)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* 6 KB of storage at the end of the 128 KB flash */
		storage_partition: partition@1e800 {
			label = "storage";
			reg = <0x0001e800 0x00001800>;
		};
	};
};
