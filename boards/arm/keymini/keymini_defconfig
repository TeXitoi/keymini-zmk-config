CONFIG_BOARD_KEYMINI=y
CONFIG_SOC_SERIES_STM32F0X=y
CONFIG_SOC_STM32F072XB=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=48000000
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_CLOCK_CONTROL=y
CONFIG_ZMK_USB=y
CONFIG_USB_SELF_POWERED=n
CONFIG_ZMK_KSCAN_MATRIX_POLLING=y

# Nothing allocates from the kernel or libc heaps, and RAM is scarce on F072.
# The libc arena defaults to all RAM left after _end: when that is smaller
# than the heap header, its init writes past the end of RAM and hard-faults.
CONFIG_HEAP_MEM_POOL_SIZE=0
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=0

# Persist keymap changes (e.g. from ZMK Studio) to the storage partition
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_NVS=y
CONFIG_SETTINGS=y

# Jump to the ST bootloader on &bootloader, see keymini.c
CONFIG_PLATFORM_SPECIFIC_INIT=y
